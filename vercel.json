{
  "framework": null,
  "buildCommand": "echo No build step",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{server,public,plugins,sdk}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/pay/:id",
      "destination": "/checkout.html"
    },
    {
      "source": "/(v1|auth|m-api|a-api|c-api|sb-api|hooks|downloads|l)/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/cron",
      "destination": "/api/index"
    },
    {
      "source": "/api/health",
      "destination": "/api/index"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/mode",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.metamask.io; connect-src 'self' https://*.metamask.io wss://*.metamask.io; frame-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://test.authorize.net https://accept.authorize.net"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "regions": [
    "icn1"
  ]
}
