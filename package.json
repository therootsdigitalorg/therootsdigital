{
  "name": "digital-hub-payments",
  "version": "3.0.0",
  "description": "DIGITAL HUB — Card Payments & Crypto Settlement: single-business Authorize.Net card platform with USD settlement reconciliation, verified USDC payouts to the admin MetaMask wallet on Base, WooCommerce plugin and double-entry ledger.",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "reset": "node server/reset.js",
    "test": "node test/console.js",
    "test:ui": "node test/ui-console.js",
    "test:sepolia": "node test/live-sepolia.js",
    "test:all": "node test/console.js && node test/ui-console.js && node test/smoke.js && node test/ui.js",
    "build:mm": "node build/mm-connect.mjs",
    "backup": "node scripts/backup.js",
    "test:legacy": "node test/smoke.js",
    "test:ui:legacy": "node test/ui.js",
    "check": "node scripts/check.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/functions": "^3.10.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@metamask/connect-evm": "^2.1.1",
    "esbuild": "^0.25.12"
  }
}
