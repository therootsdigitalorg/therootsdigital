# Copy to .env and adjust. Never commit .env.
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
DB_PATH=./data/digitalhub.db

# First super admin (created on first start). Leave ADMIN_PASSWORD empty to generate one (printed once).
ADMIN_EMAIL=admin@digitalhub.local
ADMIN_PASSWORD=

# Seed a demo merchant with sandbox payments on first start (1/0)
SEED_DEMO=1

# Legacy sandbox time for the (disabled) card flow: one "day" in test mode lasts this many ms
SANDBOX_DAY_MS=60000

# Staff must have 2FA enrolled before privileged actions (always true when NODE_ENV=production)
REQUIRE_STAFF_MFA=0

# Allow merchant webhook URLs on localhost / private networks (development only)
ALLOW_PRIVATE_WEBHOOKS=1

# ---- MetaMask USDC gateway on Base ----
# Test mode = Base Sepolia (84532), live mode = Base mainnet (8453). Comma-separated RPC URLs are tried in order (failover).
# Environment values override Super Admin → Settings → MetaMask. Leave empty to use the public Base endpoints (rate-limited, no SLA).
# Provider URLs often contain API keys: keep them server-side only. They are never sent to browsers.
# Infura (developer.metamask.io → API keys; enable Base Sepolia + Base Mainnet). Server-side only: used first for
# monitoring and verification, with the public Base endpoint as failover. INFURA_API_SECRET only if "Require API key secret" is on.
INFURA_API_KEY=
INFURA_API_SECRET=
# Optional SEPARATE Infura key for the MetaMask Connect SDK in customers' browsers. Restrict it to your domain in
# Infura (allowlist) — it is visible to anyone. Never reuse INFURA_API_KEY here.
INFURA_BROWSER_KEY=
# Explicit RPC lists override Infura and admin settings entirely (comma-separated, tried in order).
BASE_SEPOLIA_RPC_URLS=
BASE_RPC_URLS=
# Optional WebSocket endpoints (eth_subscribe newHeads) for faster detection on the long-running server
BASE_SEPOLIA_WS_URL=
BASE_WS_URL=
# HTTP polling interval for the chain monitor (ms)
CHAIN_POLL_MS=6000
# Extra hosts for MetaMask Connect in the Content-Security-Policy (space separated), if MetaMask adds relay domains
METAMASK_CONNECT_CSP=

# ---- Live payments: hard kill switch for Base mainnet. Keep OFF until every production check passes ----
LIVE_PAYMENTS=0

# ---- Legacy providers (switched off in this phase; adapters kept for later) ----
# Binance Pay Merchant API (server-side only)
BINANCE_PAY_BASE=https://bpay.binanceapi.com
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
# PEM public key from Binance Pay's certificate endpoint, with \n escapes
BINANCE_PAY_PUBLIC_KEY=

# Coinbase Commerce / Business (server-side only)
COINBASE_API_BASE=https://api.commerce.coinbase.com
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=

# ---- Supabase + Vercel ----
# On Vercel the Supabase integration's POSTGRES_URL is used automatically if DATABASE_URL is not set.
# Leave DATABASE_URL empty for local SQLite. Supabase: Connect > Transaction pooler (port 6543).
# URL-encode special characters in the password.
DATABASE_URL=
# Supabase project (Project Settings → API Keys). Used by the /sb-api endpoints (@supabase/server) and Super Admin sign-in
# through Supabase Auth. Put real values in .env (git-ignored) or the Vercel environment — never commit them.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Bypasses Row Level Security — never expose it to a browser or commit it.
SUPABASE_SECRET_KEY=
# JWKS used to verify Supabase user access tokens (https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=
# Legacy name, still accepted instead of SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=
# Required on Vercel: 64 hex characters. Generate once with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it afterwards: it decrypts webhook secrets and 2FA seeds.
APP_ENCRYPTION_KEY=
# Optional: Supabase's CA certificate (\n escaped) for full TLS verification
DATABASE_CA_CERT=
# Protects the /api/cron background job endpoint on Vercel
CRON_SECRET=
