# Copy to .env and adjust. Never commit .env.
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
DB_PATH=./data/digitalhub.db

# First super admin (created on first start). Leave ADMIN_PASSWORD empty to generate one (printed once).
ADMIN_EMAIL=admin@digitalhub.local
ADMIN_PASSWORD=

# Seed a demo merchant with sandbox payments on first start (1/0)
SEED_DEMO=1

# Sandbox time: one "day" in test mode lasts this many ms (card T+2 settlement, reserves, quote expiry)
SANDBOX_DAY_MS=60000

# Staff must have 2FA enrolled before privileged actions (always true when NODE_ENV=production)
REQUIRE_STAFF_MFA=0

# Allow merchant webhook URLs on localhost / private networks (development only)
ALLOW_PRIVATE_WEBHOOKS=1

# ---- Live payments (keep OFF until provider contracts, licensing and security review are done) ----
LIVE_PAYMENTS=0

# Binance Pay Merchant API (server-side only)
BINANCE_PAY_BASE=https://bpay.binanceapi.com
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
# PEM public key from Binance Pay's certificate endpoint, with \n escapes
BINANCE_PAY_PUBLIC_KEY=

# Coinbase Commerce / Business (server-side only)
COINBASE_API_BASE=https://api.commerce.coinbase.com
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=
