# Copy to .env and adjust. Never commit .env.
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
DB_PATH=./data/digitalhub.db

# Platform super admin. Created on first start, and re-checked on every start: if ADMIN_EMAIL signed up
# as a merchant with no activity, that account is converted to super admin with ADMIN_PASSWORD.
# Leave ADMIN_PASSWORD empty locally to generate one (printed once). Required on Vercel.
ADMIN_EMAIL=admin@digitalhub.local
ADMIN_PASSWORD=

# Seed a demo merchant with sandbox payments on first start (1/0)
SEED_DEMO=1

# Sandbox time: one "day" in test mode lasts this many ms (sandbox auto-settlement after 2 days, reserves)
SANDBOX_DAY_MS=60000

# Staff must have 2FA enrolled before privileged actions (always true when NODE_ENV=production)
REQUIRE_STAFF_MFA=0

# Allow merchant webhook URLs on localhost / private networks (development only)
ALLOW_PRIVATE_WEBHOOKS=1

# ---- Live payments (keep OFF until Cash App partner approval, production credentials and security review are done) ----
LIVE_PAYMENTS=0

# ---- Cash App Pay Partner API (server-side only — never in the browser, the database or git) ----
# Credentials come from Cash App after Digital Hub is approved as a Cash App Pay partner.
# Sandbox: leave all CASHAPP_SANDBOX_* empty to use the built-in local simulator in test mode.
# Webhook URLs to register with Cash App: <PUBLIC_URL>/hooks/cashapp/sandbox and <PUBLIC_URL>/hooks/cashapp/production
CASHAPP_REGION=PDX
CASHAPP_SANDBOX_CLIENT_ID=
CASHAPP_SANDBOX_API_KEY_ID=
# Optional in sandbox (requests are sent with sandbox:skip-signature-check when empty)
CASHAPP_SANDBOX_API_KEY_SECRET=
CASHAPP_SANDBOX_WEBHOOK_SECRET=
# Production (all four required; also set LIVE_PAYMENTS=1)
CASHAPP_CLIENT_ID=
CASHAPP_API_KEY_ID=
CASHAPP_API_KEY_SECRET=
CASHAPP_WEBHOOK_SECRET=
# Testing only: override API bases
CASHAPP_SANDBOX_BASE=
CASHAPP_BASE=

# ---- Supabase + Vercel ----
# On Vercel the Supabase integration's POSTGRES_URL is used automatically if DATABASE_URL is not set.
# Leave DATABASE_URL empty for local SQLite. Supabase: Connect > Transaction pooler (port 6543).
# URL-encode special characters in the password.
DATABASE_URL=
# Required on Vercel: 64 hex characters. Generate once with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it afterwards: it decrypts webhook secrets and 2FA seeds.
APP_ENCRYPTION_KEY=
# Optional: Supabase's CA certificate (\n escaped) for full TLS verification
DATABASE_CA_CERT=
# Protects the /api/cron background job endpoint on Vercel
CRON_SECRET=
